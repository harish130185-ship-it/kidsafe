# ===============================================
# KidSafe Activity Monitor - Environment Variables
# Copy this file to .env for local overrides.
# In Production (e.g. Render / Cloud), set these in Dashboard Settings.
# ===============================================

# Port to listen on (automatically set by Render / Railway in cloud)
PORT=8080

# Environment mode
NODE_ENV=production

# Strong random secret key for HMAC parent session signing (Generate 32+ random characters)
PARENT_TOKEN=your_super_secret_parent_hmac_token_change_in_production_3948239048

# Strong random fallback token for device pairing
DEVICE_TOKEN=your_device_pairing_secret_key_change_in_production_982374982374

# Directory for persistent database storage (On Render, point to persistent disk mount path e.g. /var/data)
# DATA_DIR=./private-data

# Optional: Real SMS Gateway Credentials (only needed if using SMS OTP instead of Email/Password)
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
